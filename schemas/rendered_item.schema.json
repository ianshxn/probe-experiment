{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval_format_mvp_rendered_item.schema.json",
  "title": "Rendered purpose-by-format item",
  "type": "object",
  "required": [
    "schema_version",
    "item_id",
    "payload_block_id",
    "topic_id",
    "task_family",
    "intended_purpose",
    "label",
    "format",
    "purpose_pair_id",
    "purpose_family_id",
    "cue_locus",
    "format_variant_id",
    "format_family_id",
    "text",
    "correct_answer",
    "answer_key",
    "canonical_payload_sha256",
    "rendered_text_sha256",
    "split_group_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "item_id": {"type": "string", "minLength": 1},
    "payload_block_id": {"type": "string", "pattern": "^pb_[a-z0-9_]{3,48}$"},
    "topic_id": {"type": "string", "pattern": "^t[0-9]{3}$"},
    "task_family": {"type": "string", "minLength": 1},
    "intended_purpose": {"enum": ["evaluation", "deployment"]},
    "label": {"enum": [0, 1]},
    "format": {"enum": ["benchmark", "casual"]},
    "purpose_pair_id": {"type": "string", "pattern": "^p[0-9]{2}$"},
    "purpose_family_id": {"type": "string", "pattern": "^ff0[1-5]$"},
    "cue_locus": {"enum": ["noun_only", "verb_only", "both"]},
    "format_variant_id": {"type": "string", "minLength": 1},
    "format_family_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "correct_answer": {"type": "string", "minLength": 1},
    "answer_key": {"type": ["string", "null"]},
    "canonical_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rendered_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_group_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

