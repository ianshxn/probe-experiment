{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval_format_mvp_payload.schema.json",
  "title": "Canonical English payload",
  "type": "object",
  "required": [
    "schema_version",
    "payload_block_id",
    "topic_id",
    "task_family",
    "context",
    "question",
    "correct_answer",
    "distractors"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "payload_block_id": {"type": "string", "pattern": "^pb_[a-z0-9_]{3,48}$"},
    "topic_id": {"type": "string", "pattern": "^t[0-9]{3}$"},
    "task_family": {
      "enum": ["classification", "numeric_reasoning", "fact_retrieval", "rule_application"]
    },
    "context": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "correct_answer": {"type": "string", "minLength": 1},
    "distractors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "generation": {
      "type": "object",
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

