{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contrastive_frame_calibration_report.schema.json",
  "title": "Frame-only human calibration evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "status",
    "purpose_frame_catalog_sha256",
    "container_catalog_sha256_en",
    "container_catalog_sha256_ja",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "human_frame_only_calibration"},
    "status": {"enum": ["pending", "passed", "failed"]},
    "purpose_frame_catalog_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "container_catalog_sha256_en": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "container_catalog_sha256_ja": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raters_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cohort_id": {"type": "string", "minLength": 1},
    "confirmatory_raters": {"type": "integer", "minimum": 5},
    "minimum_ratings_per_item": {"type": "integer", "minimum": 1},
    "languages": {
      "type": "object",
      "required": ["en", "ja"],
      "properties": {
        "en": {"$ref": "#/$defs/language_result"},
        "ja": {"$ref": "#/$defs/language_result"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "stratum_result": {
      "type": "object",
      "required": [
        "items",
        "correct",
        "balanced_accuracy",
        "eval_accuracy",
        "deploy_accuracy",
        "class_accuracy_gap",
        "wilson_95_lower_bound"
      ],
      "properties": {
        "items": {"type": "integer", "minimum": 1},
        "correct": {"type": "integer", "minimum": 0},
        "balanced_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "eval_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "deploy_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "class_accuracy_gap": {"type": "number", "minimum": 0, "maximum": 1},
        "wilson_95_lower_bound": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "language_result": {
      "type": "object",
      "required": ["strata", "gates", "pass"],
      "properties": {
        "strata": {
          "type": "object",
          "required": ["implicit", "explicit"],
          "properties": {
            "implicit": {"$ref": "#/$defs/stratum_result"},
            "explicit": {"$ref": "#/$defs/stratum_result"}
          },
          "additionalProperties": false
        },
        "gates": {
          "type": "object",
          "required": [
            "implicit_min",
            "implicit_max",
            "implicit_above_chance",
            "implicit_class_symmetry",
            "explicit_min",
            "explicit_minus_implicit"
          ],
          "properties": {
            "implicit_min": {"type": "boolean"},
            "implicit_max": {"type": "boolean"},
            "implicit_above_chance": {"type": "boolean"},
            "implicit_class_symmetry": {"type": "boolean"},
            "explicit_min": {"type": "boolean"},
            "explicit_minus_implicit": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "pass": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["passed", "failed"]}},
        "required": ["status"]
      },
      "then": {
        "required": [
          "packet_sha256",
          "results_sha256",
          "raters_sha256",
          "cohort_id",
          "confirmatory_raters",
          "minimum_ratings_per_item",
          "languages"
        ]
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "passed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "languages": {
            "properties": {
              "en": {"properties": {"pass": {"const": true}}},
              "ja": {"properties": {"pass": {"const": true}}}
            }
          }
        }
      }
    }
  ]
}
