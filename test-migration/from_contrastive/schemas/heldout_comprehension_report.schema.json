{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contrastive_heldout_comprehension_report.schema.json",
  "title": "Held-out model comprehension evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "status",
    "purpose_frame_catalog_sha256",
    "container_catalog_sha256_en",
    "container_catalog_sha256_ja",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "heldout_model_comprehension"},
    "status": {"enum": ["pending", "passed", "failed"]},
    "purpose_frame_catalog_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "container_catalog_sha256_en": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "container_catalog_sha256_ja": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_semantics_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_settings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator_models": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["profile_id", "model", "model_revision"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "model_revision": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "models_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "minimum_items_per_language_pair_class_cell": {
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["model_revision", "lineage", "languages", "pass"],
        "properties": {
          "model_revision": {"type": "string", "minLength": 1},
          "lineage": {"type": "string", "minLength": 1},
          "languages": {
            "type": "object",
            "required": ["en", "ja"],
            "properties": {
              "en": {"$ref": "#/$defs/language_result"},
              "ja": {"$ref": "#/$defs/language_result"}
            },
            "additionalProperties": false
          },
          "pass": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "stratum_result": {
      "type": "object",
      "required": [
        "items",
        "correct",
        "balanced_accuracy",
        "eval_accuracy",
        "deploy_accuracy",
        "class_accuracy_gap",
        "wilson_95_lower_bound"
      ],
      "properties": {
        "items": {"type": "integer", "minimum": 1},
        "correct": {"type": "integer", "minimum": 0},
        "balanced_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "eval_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "deploy_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "class_accuracy_gap": {"type": "number", "minimum": 0, "maximum": 1},
        "wilson_95_lower_bound": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "surface_result": {
      "type": "object",
      "required": ["items", "accuracy"],
      "properties": {
        "items": {"type": "integer", "minimum": 1},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "language_result": {
      "type": "object",
      "required": ["strata", "surface", "gates", "pass"],
      "properties": {
        "strata": {
          "type": "object",
          "required": ["implicit", "explicit"],
          "properties": {
            "implicit": {"$ref": "#/$defs/stratum_result"},
            "explicit": {"$ref": "#/$defs/stratum_result"}
          },
          "additionalProperties": false
        },
        "surface": {
          "type": "object",
          "required": ["external", "institutional"],
          "properties": {
            "external": {"$ref": "#/$defs/surface_result"},
            "institutional": {"$ref": "#/$defs/surface_result"}
          },
          "additionalProperties": false
        },
        "gates": {
          "type": "object",
          "required": [
            "implicit_min",
            "implicit_above_chance",
            "implicit_class_symmetry",
            "explicit_greater_than_implicit"
          ],
          "properties": {
            "implicit_min": {"type": "boolean"},
            "implicit_above_chance": {"type": "boolean"},
            "implicit_class_symmetry": {"type": "boolean"},
            "explicit_greater_than_implicit": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "pass": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["passed", "failed"]}},
        "required": ["status"]
      },
      "then": {
        "required": [
          "dataset_sha256",
          "results_sha256",
          "models_sha256",
          "minimum_items_per_language_pair_class_cell",
          "catalog_semantics_sha256",
          "request_projection_sha256",
          "generation_settings_sha256",
          "generator_models",
          "models"
        ]
      }
    }
  ]
}
