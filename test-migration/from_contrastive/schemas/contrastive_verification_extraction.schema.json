{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contrastive_verification_extraction.schema.json",
  "title": "Blind extraction of a generated contrastive item",
  "type": "object",
  "required": [
    "is_answerable_from_content",
    "independently_selected_option",
    "leaked_answer_signal",
    "matches_authoring_requirements",
    "register_appropriate",
    "distractors_plausible",
    "distractor_notes",
    "register_notes"
  ],
  "properties": {
    "is_answerable_from_content": {"type": "boolean"},
    "independently_selected_option": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 4
    },
    "leaked_answer_signal": {"type": "boolean"},
    "matches_authoring_requirements": {"type": "boolean"},
    "register_appropriate": {"type": "boolean"},
    "distractors_plausible": {"type": "boolean"},
    "distractor_notes": {"type": "string"},
    "register_notes": {"type": "string"}
  },
  "additionalProperties": false
}
