{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contrastive_cue_invariant_confirmatory_controls.schema.json",
  "title": "Fresh confirmation for the cue-invariant purpose probe",
  "type": "object",
  "required": ["schema_version", "protocol_version", "status", "frozen_at", "description", "development", "gate", "rendering", "purpose_variants", "cue_variants", "blocks"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"const": "2.0.0"},
    "status": {"const": "frozen_unscored"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "description": {"type": "string", "minLength": 1},
    "development": {
      "type": "object",
      "required": ["result_sha256", "spent_controls_sha256", "method", "variance_fraction", "fitting_recipe", "position", "layer", "rule"],
      "properties": {
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "spent_controls_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "method": {"const": "matched_cue_difference_svd"},
        "variance_fraction": {"const": 0.9},
        "fitting_recipe": {"const": "explicit_only"},
        "position": {"const": "mean"},
        "layer": {"const": 6},
        "rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["bootstrap_unit", "bootstrap_samples", "bootstrap_seed", "thresholds", "no_method_or_cell_selection"],
      "properties": {
        "bootstrap_unit": {"const": "control_block_id"},
        "bootstrap_samples": {"type": "integer", "minimum": 2000},
        "bootstrap_seed": {"const": 20260805},
        "thresholds": {
          "type": "object",
          "required": ["purpose_auc_each_cue_family_each_language", "purpose_auc_each_surface_each_cue_family_each_language", "purpose_auc_within_each_lexical_cue_each_family_each_language", "cluster_bootstrap_lower_bound_strictly_above", "max_abs_lexical_cue_main_effect_fitting_sd"],
          "properties": {
            "purpose_auc_each_cue_family_each_language": {"const": 0.75},
            "purpose_auc_each_surface_each_cue_family_each_language": {"const": 0.65},
            "purpose_auc_within_each_lexical_cue_each_family_each_language": {"const": 0.65},
            "cluster_bootstrap_lower_bound_strictly_above": {"const": 0.5},
            "max_abs_lexical_cue_main_effect_fitting_sd": {"const": 0.25}
          },
          "additionalProperties": false
        },
        "no_method_or_cell_selection": {"const": true}
      },
      "additionalProperties": false
    },
    "rendering": {
      "type": "object",
      "required": ["separator", "field_order", "cue_line_templates"],
      "properties": {
        "separator": {"const": "\n\n"},
        "field_order": {"const": ["purpose", "cue_line", "payload"]},
        "cue_line_templates": {
          "type": "object",
          "required": ["en", "ja"],
          "properties": {
            "en": {"const": "Context tag: {cue_term}."},
            "ja": {"const": "文脈タグ：{cue_term}。"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "purpose_variants": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/purposeVariant"}},
    "cue_variants": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/cueVariant"}},
    "blocks": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/block"}}
  },
  "$defs": {
    "localizedPair": {
      "type": "object", "required": ["evaluation", "deployment"],
      "properties": {"evaluation": {"type": "string", "minLength": 1}, "deployment": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "purposeVariant": {
      "type": "object", "required": ["purpose_variant_id", "surface", "en", "ja"],
      "properties": {
        "purpose_variant_id": {"type": "string", "pattern": "^cipv(?:0[1-9]|1[0-6])$"},
        "surface": {"enum": ["external", "institutional"]},
        "en": {"$ref": "#/$defs/localizedPair"}, "ja": {"$ref": "#/$defs/localizedPair"}
      }, "additionalProperties": false
    },
    "cueVariant": {
      "type": "object", "required": ["cue_variant_id", "explicit_lexeme", "implicit_cue"],
      "properties": {
        "cue_variant_id": {"type": "string", "pattern": "^cicv0[1-8]$"},
        "explicit_lexeme": {"$ref": "#/$defs/cueFamilyPair"}, "implicit_cue": {"$ref": "#/$defs/cueFamilyPair"}
      }, "additionalProperties": false
    },
    "cueFamilyPair": {
      "type": "object", "required": ["en", "ja"],
      "properties": {"en": {"$ref": "#/$defs/localizedPair"}, "ja": {"$ref": "#/$defs/localizedPair"}},
      "additionalProperties": false
    },
    "block": {
      "type": "object", "required": ["control_block_id", "surface", "purpose_variant_id", "cue_variant_id", "payload"],
      "properties": {
        "control_block_id": {"type": "string", "pattern": "^cicb(?:0[1-9]|1[0-6])$"},
        "surface": {"enum": ["external", "institutional"]},
        "purpose_variant_id": {"type": "string", "pattern": "^cipv(?:0[1-9]|1[0-6])$"},
        "cue_variant_id": {"type": "string", "pattern": "^cicv0[1-8]$"},
        "payload": {
          "type": "object", "required": ["en", "ja"],
          "properties": {"en": {"type": "string", "minLength": 200}, "ja": {"type": "string", "minLength": 80}},
          "additionalProperties": false
        }
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
